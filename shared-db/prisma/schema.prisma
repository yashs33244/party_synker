generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String        @id @default(cuid())
  name                String?
  email               String        @unique
  mongoAuthId         String        @unique
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  joinedRooms         UsersInRoom[] @relation("UserRooms")
  hostedRooms         Room[]        @relation("RoomHost")
  messages            Message[]
  spotifyId           String?       @unique
  spotifyAccessToken  String?
  spotifyRefreshToken String?
  spotifyDeviceId     String?
  spotifyTokenExpiry  DateTime?

  @@index([spotifyId])
}

model Room {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  closedAt  DateTime?
  users     UsersInRoom[]
  hostId    String
  host      User          @relation("RoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  roomName  String?
  messages  Message[]
  expiresAt DateTime      @default(dbgenerated("NOW() + interval '1 hour'"))

  @@index([expiresAt])
}

model UsersInRoom {
  user     User      @relation("UserRooms", fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  room     Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId   String
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  @@id([userId, roomId])
}

model Message {
  id        String    @id @default(cuid())
  content   String
  type      String    @default("TEXT")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId    String
  isEdited  Boolean   @default(false)
  deletedAt DateTime?

  @@index([roomId, createdAt])
  @@index([userId])
}
