// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String        @id @default(cuid())
  name        String?
  email       String        @unique
  mongoAuthId String        @unique // Store MongoDB _id here
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  joinedRooms UsersInRoom[]
  hostedRooms Room[]        @relation("RoomHost")
  messages    Message[] // Add relation to messages
}

model Room {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  closedAt  DateTime?
  users     UsersInRoom[]
  hostId    String
  host      User          @relation("RoomHost", fields: [hostId], references: [id])
  roomName  String?
  messages  Message[] // Add relation to messages
}

model UsersInRoom {
  user     User      @relation(fields: [userId], references: [id])
  userId   String
  room     Room      @relation(fields: [roomId], references: [id])
  roomId   String
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  @@id([userId, roomId])
}

model Message {
  id        String    @id @default(cuid())
  content   String
  type      String    @default("TEXT")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt // Add updatedAt field
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  room      Room      @relation(fields: [roomId], references: [id])
  roomId    String
  isEdited  Boolean   @default(false) // Add field to track edits
  deletedAt DateTime? // Soft delete support

  @@index([roomId, createdAt]) // Add index for querying messages in a room
  @@index([userId]) // Add index for querying user's messages
}
